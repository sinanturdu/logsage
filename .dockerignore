# Docker build context for backend/Dockerfile (context: the repository root).
# Allow-list: only the backend and frontend sources go in; then exclude
# secrets, local state, dependencies and build output inside them.
*
!backend/
!frontend/

# Secrets and local state, wherever they are.
**/.env
**/.env.*
**/.dev
**/*.pem
**/*.key
**/*.p12
**/id_rsa*
**/jar.txt
**/*cookie*

# Dependencies and build output (rebuilt inside the image).
**/node_modules
**/dist
**/coverage
**/.vite
backend/bin
**/*.exe
**/*.test
**/*.out
**/*.prof

# Test data and editor files.
backend/**/testdata/tmp
**/.DS_Store
**/.idea
**/.vscode
