# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=logsage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logsage
POSTGRES_DSN=postgres://logsage:change-me@localhost:5432/logsage?sslmode=disable

CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/logsage
REDIS_ADDR=localhost:6379

HTTP_ADDR=:8080
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
# LOG_FORMAT: json | text
LOG_FORMAT=json
JWT_SECRET=change-me

# Ingest API. INGEST_API_KEY is required by cmd/ingest; use a long random value.
INGEST_API_KEY=change-me
# Limits (defaults shown)
INGEST_MAX_BODY_BYTES=1048576
INGEST_MAX_EVENTS=1000
INGEST_MAX_MESSAGE_BYTES=8192
INGEST_MAX_ATTRIBUTES=32
INGEST_MAX_ATTR_KEY_CHARS=64
INGEST_MAX_ATTR_VALUE_CHARS=1024
