# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=logsage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logsage
# PostgreSQL for projects and API keys (cmd/admin; services from v0.2 package H).
# Either DATABASE_URL (percent-encode special characters in the password) or the
# POSTGRES_* parts above plus POSTGRES_HOST/POSTGRES_PORT (localhost:5432).
DATABASE_URL=postgres://logsage:change-me@localhost:5432/logsage?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=5s


HTTP_ADDR=:8080
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
# LOG_FORMAT: json | text
LOG_FORMAT=json
JWT_SECRET=change-me

# Ingest API. INGEST_API_KEY is required by cmd/ingest; use a long random value.
INGEST_API_KEY=change-me
# Limits (defaults shown)
INGEST_MAX_BODY_BYTES=1048576
INGEST_MAX_EVENTS=1000
INGEST_MAX_MESSAGE_BYTES=8192
INGEST_MAX_ATTRIBUTES=32
INGEST_MAX_ATTR_KEY_CHARS=64
INGEST_MAX_ATTR_VALUE_CHARS=1024
INGEST_MAX_TRACE_ID_LEN=128
# Backpressure: ingest answers 429 (Retry-After) while the Redis stream holds at
# least this many entries. Soft limit, checked against a cached XLEN (ADR 0010).
INGEST_MAX_STREAM_LEN=500000

# Where accepted events go: memory (default, lost on restart) | redis
PUBLISHER=memory
# Redis Streams publisher (REDIS_ADDR is required when PUBLISHER=redis)
REDIS_ADDR=localhost:6379
REDIS_STREAM=logsage:events
# Per-operation timeout, Go duration syntax (500ms, 2s)
REDIS_TIMEOUT=2s

# ClickHouse HTTP interface used by cmd/processor (credentials go in USER/PASSWORD, never in the URL)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=logsage
CLICKHOUSE_USER=logsage
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_TIMEOUT=10s
# Retention of logsage.logs, applied when the table is created
CLICKHOUSE_TTL_DAYS=30

# Processor (Redis Stream -> ClickHouse). Uses REDIS_ADDR, REDIS_STREAM, REDIS_TIMEOUT above.
PROCESSOR_HTTP_ADDR=:8081
# Consumer name in the group; empty means hostname-pid
PROCESSOR_CONSUMER=
PROCESSOR_DEAD_STREAM=logsage:events:dead
PROCESSOR_BATCH_SIZE=1000
PROCESSOR_FLUSH_INTERVAL=1s
PROCESSOR_READ_COUNT=1000
PROCESSOR_READ_BLOCK=1s
PROCESSOR_CLAIM_IDLE=30s
PROCESSOR_CLAIM_INTERVAL=10s
PROCESSOR_RETRY_INITIAL=200ms
PROCESSOR_RETRY_MAX=30s
PROCESSOR_STATS_INTERVAL=10s
PROCESSOR_SHUTDOWN_TIMEOUT=10s
# Safe trimming: every interval, XTRIM MINID up to what every consumer group has finished
PROCESSOR_TRIM_INTERVAL=5s
# Warn when the oldest unprocessed entry is older than this
PROCESSOR_LAG_WARN_AGE=30s
# Approximate cap on the dead-letter stream
PROCESSOR_DEAD_MAXLEN=100000

# Query API (cmd/query, read-only). QUERY_API_KEY is required and must differ from INGEST_API_KEY.
QUERY_HTTP_ADDR=:8082
QUERY_API_KEY=change-me-too
# Largest from..to range per request (Go duration)
QUERY_MAX_WINDOW=168h
QUERY_MAX_LIMIT=1000
# ClickHouse max_execution_time per query (at least 1s)
QUERY_TIMEOUT=10s
# Max characters of q, service and trace_id
QUERY_MAX_TEXT_LEN=256

# API key authentication (ingest and query, ADR 0012). With DATABASE_URL set,
# per-project keys from PostgreSQL are verified (create them with cmd/admin).
# A verified key stays valid for AUTH_CACHE_TTL without a database check, so a
# revoked key or disabled project can keep working that long.
AUTH_CACHE_TTL=30s
AUTH_NEGATIVE_TTL=5s
AUTH_CACHE_SIZE=10000
# Deprecated, off by default since v0.2.0: true keeps INGEST_API_KEY /
# QUERY_API_KEY working for the default project during an upgrade. The
# static keys are removed in v0.3; use per-project keys (API keys screen).
ALLOW_LEGACY_STATIC_KEYS=false

# Management API (cmd/api, ADR 0013/0014): users, sessions, projects, keys
# and the dashboard's log read endpoints. Needs DATABASE_URL and all of
# CLICKHOUSE_URL, CLICKHOUSE_DB, CLICKHOUSE_USER and CLICKHOUSE_PASSWORD set
# explicitly; log reads use the QUERY_* limits above. Sessions are
# server-side; the cookie holds a random token.
API_HTTP_ADDR=:8083
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=168h
# Secure cookie with the __Host- prefix. Set false only for local plain http.
COOKIE_SECURE=true
# Comma-separated scheme://host[:port] origins allowed for CORS and CSRF
# checks (empty: same host only). Never "*".
ALLOWED_ORIGINS=
# The dashboard served by cmd/api (ADR 0021) and the ingest address it shows
# in its examples (http or https, no credentials, query or fragment).
WEB_ENABLED=true
PUBLIC_INGEST_URL=http://localhost:8080
# Self-service sign-up; off by default (create users with cmd/admin).
REGISTRATION_ENABLED=false
# argon2id cost (OWASP minimum m=19456 KiB) and concurrent hash limit.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_MAX_CONCURRENT=4
# Login throttling per client IP and per email (in memory, per instance).
LOGIN_MAX_FAILURES=5
LOGIN_DELAY_BASE=1s
LOGIN_DELAY_MAX=15m
LOGIN_LIMITER_SIZE=10000
# Log reads one user may run at once on the management API; more get 429.
API_MAX_CONCURRENT_QUERIES=4

# Live tail on the management API (ADR 0015): GET /api/projects/{slug}/tail.
# Poll interval and rows per poll (a full batch polls again at once).
TAIL_POLL_INTERVAL=1s
TAIL_BATCH=200
# Heartbeat event; streams close after TAIL_MAX_DURATION and the client resumes.
TAIL_HEARTBEAT=15s
TAIL_MAX_DURATION=1h
# Session, disabled user and membership are re-checked this often.
TAIL_AUTH_RECHECK=30s
# Last-Event-ID older than this gets a reset (the client refetches via /logs).
TAIL_MAX_REPLAY=5m
# Logs whose event timestamp is older than this are not streamed live.
TAIL_MAX_LATENESS=10m
# How much later than its inserted_at a row may become visible and still be
# streamed; keep it above the processor's ClickHouse insert time (CLICKHOUSE_TIMEOUT).
TAIL_OVERLAP=30s
# A client slower than this per write is dropped; backoff cap while ClickHouse fails.
TAIL_WRITE_TIMEOUT=10s
TAIL_RETRY_MAX=30s
# Open streams per user, per project and in total (above: 429 + Retry-After).
TAIL_MAX_CONN_USER=2
TAIL_MAX_CONN_PROJECT=10
TAIL_MAX_CONN_TOTAL=50
# Delivered event ids remembered per stream for deduplication.
TAIL_MAX_SEEN=50000
